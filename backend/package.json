{
  "name": "world-link-backend",
  "version": "1.0.0",
  "description": "World Link Alpha Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:contract": "NODE_ENV=test node --import tsx --test test/contract.test.ts",
    "test:e2e": "NODE_ENV=test node --import tsx --test test/e2e-*.test.ts",
    "test": "npm run test:contract && npm run test:e2e",
    "billing:reconcile": "node scripts/reconcile-billing.mjs",
    "billing:reconcile:fix": "node scripts/reconcile-billing.mjs --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "apidoc": "apidoc -i src/ -o apidoc/"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "apidoc": "^1.2.0",
    "eslint": "^10.2.1",
    "prisma": "^5.22.0",
    "tsx": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
