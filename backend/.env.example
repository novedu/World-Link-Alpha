# =========================
# 环境切换说明（基础）
# 1) 开发环境：优先使用 backend/.env.development（可保留 backend/.env 作为兜底）
#    启动：cd backend && npm run dev
# 2) 测试环境：使用 backend/.env.test（NODE_ENV="test"）
# 3) 生产环境：使用 backend/.env.production（不要直接复用开发配置）
#    至少替换 DATABASE_URL / JWT_SECRET / ALLOWED_ORIGINS，并将 NODE_ENV="production"
#    启动：cd backend && npm run build && npm run start
# =========================

# Database
DATABASE_URL="file:./worldlink.db"
# If you switch Prisma datasource provider to postgresql, use:
# DATABASE_URL="postgresql://username:password@localhost:5432/worldlink?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
# development / production / test（三者会影响日志级别、鉴权与错误输出策略）
NODE_ENV="development"

# CORS (Extension ID for Chrome Extension)
ALLOWED_ORIGINS="chrome-extension://*,http://localhost:3000"
