# World-Link Alpha Backend - Development Environment
NODE_ENV="development"
PORT=3001

# Database
DATABASE_URL="file:./worldlink.db"

# JWT (仅开发使用，生产必须替换为强密钥)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS
ALLOWED_ORIGINS="chrome-extension://*,http://localhost:3000"

