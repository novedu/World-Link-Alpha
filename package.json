{
  "name": "world-link-alpha",
  "version": "1.0.0",
  "description": "",
  "main": "background.js",
  "scripts": {
    "build:backend": "cd backend && npm run build",
    "build:sidepanel": "cd sidepanel && npm run build",
    "build": "npm run build:backend && npm run build:sidepanel",
    "typecheck:backend": "cd backend && npm run typecheck",
    "typecheck:sidepanel": "cd sidepanel && npm run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:sidepanel",
    "test:e2e:backend": "cd backend && npm run test:e2e",
    "test:e2e:backend:socket": "cd backend && RUN_SOCKET_E2E=1 npm run test:e2e",
    "test:e2e": "npm run test:e2e:backend",
    "test:backend": "cd backend && npm run test",
    "test:sidepanel": "cd sidepanel && npm run test",
    "test": "npm run test:backend && npm run test:sidepanel",
    "lint:backend": "cd backend && npm run lint",
    "lint:sidepanel": "cd sidepanel && npm run lint",
    "lint": "npm run lint:backend && npm run lint:sidepanel",
    "check:docs": "node scripts/check-docs-consistency.mjs",
    "security:env": "node scripts/security/check-env-security.mjs",
    "backup:db": "node scripts/ops/backup-db.mjs manual",
    "backup:drill": "node scripts/ops/drill-backup-restore.mjs",
    "release:manifest": "node scripts/release/create-release-manifest.mjs",
    "release:rollback:check": "node scripts/release/verify-rollback-ready.mjs",
    "billing:reconcile": "node backend/scripts/reconcile-billing.mjs",
    "billing:reconcile:fix": "node backend/scripts/reconcile-billing.mjs --fix",
    "verify": "npm run lint && npm run typecheck && npm run check:docs && npm run security:env && npm run test && npm run build",
    "verify:fullchain": "npm run verify && npm run test:e2e:backend:socket && npm run release:rollback:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novedu/World-Link-Alpha.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/novedu/World-Link-Alpha/issues"
  },
  "homepage": "https://github.com/novedu/World-Link-Alpha#readme"
}
